{
  "title": "Dev Radar",
  "tagline": "What just shipped, checked every two hours",
  "timezone": "Asia/Kolkata",
  "schedule_hours": 2,
  "lookback_hours": 24,
  "max_items": 60,
  "http_timeout_seconds": 25,
  "ranking": {
    "boost_keywords": {
      "release": 1.5,
      "released": 1.5,
      "launch": 1.2,
      "launched": 1.2,
      "open source": 1.2,
      "open-source": 1.2,
      "general availability": 1.4,
      "benchmark": 0.8,
      "state of the art": 1.0,
      "agent": 0.8,
      "agents": 0.6,
      "llm": 0.6,
      "model": 0.5,
      "security": 0.7,
      "vulnerability": 1.0,
      "breaking change": 1.0,
      "deprecated": 0.8,
      "framework": 0.5
    },
    "demote_keywords": [
      "sponsored",
      "advertisement",
      "coupon",
      "giveaway"
    ]
  },
  "feeds": [
    { "name": "OpenAI", "url": "https://openai.com/news/rss.xml", "categories": ["ai"] },
    { "name": "Google AI", "url": "https://blog.google/technology/ai/rss/", "categories": ["ai"] },
    { "name": "Hugging Face", "url": "https://huggingface.co/blog/feed.xml", "categories": ["ai", "open-source"] },
    { "name": "Simon Willison", "url": "https://simonwillison.net/atom/everything/", "categories": ["ai", "dev"] },
    { "name": "TechCrunch", "url": "https://techcrunch.com/feed/", "categories": ["tech", "startups"] },
    { "name": "The Verge", "url": "https://www.theverge.com/rss/index.xml", "categories": ["tech"] },
    { "name": "Ars Technica", "url": "https://feeds.arstechnica.com/arstechnica/index", "categories": ["tech"] },
    { "name": "MIT Tech Review", "url": "https://www.technologyreview.com/feed/", "categories": ["tech", "research"] },
    { "name": "VentureBeat AI", "url": "https://venturebeat.com/category/ai/feed/", "categories": ["ai", "business"] },
    { "name": "arXiv cs.AI", "url": "http://export.arxiv.org/rss/cs.AI", "categories": ["research", "ai"] },
    { "name": "Hacker News", "url": "https://hnrss.org/frontpage", "categories": ["dev", "community"] },
    { "name": "GitHub Blog", "url": "https://github.blog/feed/", "categories": ["dev"] },
    { "name": "Dev.to", "url": "https://dev.to/feed", "categories": ["dev", "community"] }
  ],
  "agent_reach": {
    "enabled": true,
    "read_top_n": 8,
    "timeout_seconds": 60,
    "read_backend": "public-web",
    "searches": [
      {
        "channel": "web",
        "action": "search",
        "query": "latest AI model release",
        "limit": 5,
        "categories": ["ai"]
      },
      {
        "channel": "web",
        "action": "search",
        "query": "developer tools release this week",
        "limit": 5,
        "categories": ["dev"]
      }
    ]
  },
  "delivery": {
    "ntfy": true,
    "telegram": true
  }
}
